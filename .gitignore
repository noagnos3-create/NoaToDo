# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environment
src/venv/
venv/
.venv/

# App data: encrypted DB, logs, runtime state (never commit user data)
src/data/
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.log
# Der echte Tresor (und seine Sicherungsgeneration) gehoert nie ins Repo,
# auch verschluesselt nicht: das sind Nutzerdaten, keine Quelltexte.
*.db.enc
*.db.enc.bak
*.db.enc.tmp

# Build-Artefakte der Auslieferung (Phase 9): das Bundle und der beim Bauen
# erzeugte Stempel (Build-Datum, Commit, Frontend-Manifest) sind Ergebnisse,
# keine Quellen. Der Stempel wird nach jedem Build ohnehin geloescht.
src/build/
src/dist/
src/_buildstamp.py

# Secrets / local config
.env
*.secret

# Claude Code local settings
.claude/

